<Project Sdk="Microsoft.NET.Sdk">

  <!-- Inert ZIP-ONLY asset package: the .nupkg ships ONLY data + inspectable MSBuild XML, NO code.
       This is a packing-only project — it emits no assembly (IncludeBuildOutput=false), has no
       source and no dependencies. `dotnet pack` builds it cross-platform with no mono / nuget.exe
       (ubuntu-latest dropped the mono that nuget.exe needs). Package metadata comes from
       Directory.Build.props (authors, license, icon, repo, copyright, language) plus the id +
       description below; the <None Pack="true"> items are the ENTIRE payload — an explicit allowlist
       of exactly what ships:
         build/spa.zip                                  SPA bundle (colors/icons live inside it at
                                                         branding/<theme>/manifest.json)
         build/VpnHood.AppLib.Assets.ClassicSpa.targets NuGet auto-imports this for the consumer; it
                                                         embeds spa.zip into the consuming assembly
         VpnHood.png                                    package icon (root)
       Version flows from CI via -p:PackageVersion=<X>; Directory.Build.props holds the base number. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>VpnHood.AppLib.Assets.ClassicSpa</PackageId>
    <Description>VpnHood client SPA bundle (spa.zip) as an inert asset package — no compiled code. The consuming project's build embeds spa.zip via the included MSBuild targets.</Description>

    <!-- Emit no assembly into the package and nothing to symbolize; compile no stray files; and do
         not fabricate a dependencies group (there are none). -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Content-only package: silence the "no lib/ assemblies" advisory. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Resources/spa.zip" Pack="true" PackagePath="build/spa.zip" />
    <None Include="build/VpnHood.AppLib.Assets.ClassicSpa.targets" Pack="true" PackagePath="build/" />
    <None Include="../VpnHood.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
