<Project>
	<!-- Embeds the SPA bundle into the CONSUMING assembly (VpnHood.App.Client). NuGet auto-imports
	     build/<PackageId>.targets for the direct PackageReference, so referencing this package is all
	     it takes for spa.zip to end up embedded in the app — identical at runtime to a normal embedded
	     resource, on every platform, single-file-publish included.

	     The package ships ONLY this glue + the zip (no compiled code, IncludeBuildOutput=false), so the
	     SPA is an inert data asset. The LogicalName is the contract the app's SpaAsset loader reads;
	     the local use-local-spa embed in VpnHood.App.Client.csproj uses the same name. -->
	<ItemGroup>
		<EmbeddedResource Include="$(MSBuildThisFileDirectory)spa.zip">
			<LogicalName>VpnHood.App.Client.spa.zip</LogicalName>
			<Visible>false</Visible>
		</EmbeddedResource>
	</ItemGroup>
</Project>
