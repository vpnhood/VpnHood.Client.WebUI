<?xml version="1.0" encoding="utf-8"?>
<!-- ZIP-ONLY package: the shipped .nupkg contains only data + inspectable MSBuild XML, NO compiled
     code. The package ships:
       build/spa.zip                                  the SPA bundle (colors/icons live inside it,
                                                       at branding/<theme>/manifest.json)
       build/VpnHood.AppLib.Assets.ClassicSpa.targets NuGet auto-imports this for the consumer; it
                                                       embeds spa.zip into the consuming assembly
       VpnHood.png                                    package icon (package root)
     Packed by CI with `dotnet pack VpnHood.AppLib.Assets.ClassicSpa.pack.csproj` — a mono-free,
     cross-platform packing SHIM that emits no assembly and only drives this .nuspec (ubuntu-latest
     no longer ships the mono that nuget.exe needs). The version flows in from the bump step via
     -p:NuspecProperties=version=<X>, substituted into the $version$ token below.
     Metadata here duplicates what Directory.Build.props gives MSBuild projects, because nuspec-based
     packing ignores Directory.Build.props. -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>VpnHood.AppLib.Assets.ClassicSpa</id>
    <version>$version$</version>
    <authors>VpnHood</authors>
    <owners>VpnHood</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">LGPL-2.1-only</license>
    <icon>VpnHood.png</icon>
    <projectUrl>https://github.com/vpnhood/VpnHood.AppLib.Assets.ClassicSpa</projectUrl>
    <description>VpnHood client SPA bundle (spa.zip) as an inert asset package — no compiled code. The consuming project's build embeds spa.zip via the included MSBuild targets.</description>
    <copyright>© OmegaHood LLC. All rights reserved.</copyright>
    <repository type="git" url="https://github.com/vpnhood/VpnHood.AppLib.Assets.ClassicSpa" />
    <language>en</language>
  </metadata>
  <files>
    <file src="Resources/spa.zip" target="build/spa.zip" />
    <file src="build/VpnHood.AppLib.Assets.ClassicSpa.targets" target="build/" />
    <file src="../VpnHood.png" target="" />
  </files>
</package>
